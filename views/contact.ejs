<%- include('partials/head', { pageTitle: 'Contact - Kelley Castillo' }) %>
<%- include('partials/navbar') %>

<div class="page">
    <!-- CONTACT FORM  -->
    <section class="section">
        <h2 class="form-title">Contact Form</h2>
        
        <form id="guestbookForm" class="guestbook-form" action="/guestbook" method="POST">
            <div class="form-row">
                <div class="form-group">
                    <label for="firstName">First Name</label>
                    <input id="firstName" name="firstName" type="text">
                    <span id="firstName-error" class="error-message">First name is required</span>
                </div>
                <div class="form-group">
                    <label for="lastName">Last Name</label>
                    <input id="lastName" name="lastName" type="text">
                    <span id="lastName-error" class="error-message">Last name is required</span>
                </div> 
                <div class="form-group">
                    <label for="jobTitle">Job Title</label>
                    <input id="jobTitle" name="jobTitle" type="text">
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="company">Company</label>
                    <input id="company" name="company" type="text">
                </div>
                <div class="form-group">
                    <label for="linkedin">LinkedIn URL</label>
                    <input id="linkedin" name="linkedin" type="url">
                    <span id="linkedin-error" class="error-message">LinkedIn URL must start with https://linkedin.com/in/</span>
                </div>
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input id="email" name="email" type="email">
                    <span id="email-error" class="error-message">Please enter a valid email address</span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group full-width">
                    <label for="howMet">How did we meet?</label>
                    <select id="howMet" name="howMet">
                        <option value="">Please select</option>
                        <option value="Class">Class</option>
                        <option value="LinkedIn">LinkedIn</option>
                        <option value="Job">Job</option>
                        <option value="Other">Other</option>
                    </select>
                    <span id="howMet-error" class="error-message">Please select how we met</span>
                </div>
            </div>

            <div class="form-row" id="otherRow" style="display: none;">
                <div class="form-group full-width">
                    <label for="howMetOther">Other (Please Specify)</label>
                    <input id="howMetOther" name="howMetOther" type="text" placeholder="Please specify">
                </div>
            </div>

            <div class="form-row">
                <div class="form-group full-width">
                    <label for="message">Message</label>
                    <textarea id="message" name="message" rows="4"></textarea>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group checkbox-group">
                    <label class="checkbox-label">
                        <input type="checkbox" id="mailingList" name="mailingList">
                        <span class="checkmark"></span>
                        Please add me to your mailing list
                    </label>
                    <label class="format-label">
                        <input type="radio" name="emailFormat" value="html" checked> HTML email format
                        <input type="radio" name="emailFormat" value="text"> Text
                    </label>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit">Submit</button>
            </div>
        </form>
    </section>
</div>

<script src="/validation.js"></script>
<script src="/confirmation.js"></script>

<%- include('partials/footer') %>